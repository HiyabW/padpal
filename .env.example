# Local development (copy to .env):
# REACT_APP_API_URL=http://localhost:3007
#
# Production web build (set in CI/hosting before npm run build):
# REACT_APP_API_URL=https://palpal-api.onrender.com
#
# Capacitor iOS/Android (required for simulator/device — not localhost):
# REACT_APP_API_URL=https://palpal-api.onrender.com
# CAPACITOR_DEV_SERVER_URL=http://localhost:3000   # optional live reload
REACT_APP_API_URL=http://localhost:3007
